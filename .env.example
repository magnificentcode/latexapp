# --- Database (Railway Postgres) ---
# Railway auto-injects DATABASE_URL when a Postgres service is attached to
# the project. For local dev, point this at your own Postgres instance.
DATABASE_URL=postgresql://user:pass@localhost:5432/latexapp

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# --- CORS ---
# Comma-separated list. Leave unset for local dev (same-origin only, no
# separate frontend domain).
ALLOWED_ORIGINS=

# --- LaTeX compilation ---
TECTONIC_TIMEOUT_SECONDS=45

ENVIRONMENT=development
